      "questions": [
        {
          "n": 3,
          "marks": 2,
          "type": "short",
          "question": "In the figure, the line $y = 4$ meets the parabola $y = x^2$ at A and B. Find the slope of the tangent to the parabola at B.",
          "figure": "figs/q-parabola.svg",
          "solution": {
            "answer": "Slope of the tangent at $B(2, 4)$ is $4$.",
            "steps": [
              { "do": "Put $y = 4$ in $y = x^2$.", "math": "x^2 = 4 \\Rightarrow x = \\pm 2", "marks": 0.5 },
              { "do": "B is on the right, so take $x = 2$.", "math": "B = (2, 4)", "marks": 0.5 },
              { "do": "Differentiate $y = x^2$ w.r.t. $x$.", "math": "\\dfrac{dy}{dx} = 2x", "marks": 0.5 },
              { "do": "Put $x = 2$.", "math": "\\left.\\dfrac{dy}{dx}\\right|_{x = 2} = 2(2) = 4", "marks": 0.5 }
            ]
          }
        },
        {
          "n": 4,
          "marks": 3,
          "type": "short",
          "question": "Evaluate $\\displaystyle\\int_{-1}^{3} |x - 1|\\,dx$.",
          "solution": {
            "answer": "$\\displaystyle\\int_{-1}^{3} |x - 1|\\,dx = 4$",
            "concept": "Split the integral where the expression inside the modulus changes sign.",
            "steps": [
              { "do": "Sketch $y = |x - 1|$; it changes form at $x = 1$.", "figure": "figs/step-abs.svg" },
              { "do": "Split the integral at $x = 1$.", "math": "\\int_{-1}^{3} |x - 1|\\,dx = \\int_{-1}^{1} (1 - x)\\,dx + \\int_{1}^{3} (x - 1)\\,dx", "marks": 1 },
              { "do": "Integrate each part and put in the limits.", "math": "\\begin{aligned} &= \\left[x - \\dfrac{x^2}{2}\\right]_{-1}^{1} + \\left[\\dfrac{x^2}{2} - x\\right]_{1}^{3} \\\\ &= \\left[\\left(1 - \\dfrac{1}{2}\\right) - \\left(-1 - \\dfrac{1}{2}\\right)\\right] + \\left[\\left(\\dfrac{9}{2} - 3\\right) - \\left(\\dfrac{1}{2} - 1\\right)\\right] \\\\ &= 2 + 2 \\end{aligned}", "marks": 1.5 },
              { "do": "Add.", "math": "= 4", "marks": 0.5 }
            ],
            "mistake": "Do not integrate $(x - 1)$ over $[-1, 3]$ in one go; split where the modulus changes sign."
          }
        },
        {
          "n": 5,
          "marks": 2,
          "type": "short",
          "question": "If $A = \\begin{bmatrix} 1 & -1 & 2 & 0 \\\\ 2 & 0 & 1 & 3 \\end{bmatrix}$ and $B = \\begin{bmatrix} 2 & 1 & 0 \\\\ 0 & 3 & 1 \\\\ 1 & 0 & 2 \\\\ 3 & 1 & -1 \\end{bmatrix}$, find $AB$.",
          "solution": {
            "answer": "$AB = \\begin{bmatrix} 4 & -2 & 3 \\\\ 14 & 5 & -1 \\end{bmatrix}$",
            "steps": [
              { "do": "$A$ is $2 \\times 4$ and $B$ is $4 \\times 3$, so $AB$ is $2 \\times 3$.", "marks": 0.5 },
              { "do": "Multiply each row of $A$ by each column of $B$.", "math": "AB = \\begin{bmatrix} 1(2) + (-1)(0) + 2(1) + 0(3) & 1(1) + (-1)(3) + 2(0) + 0(1) & 1(0) + (-1)(1) + 2(2) + 0(-1) \\\\ 2(2) + 0(0) + 1(1) + 3(3) & 2(1) + 0(3) + 1(0) + 3(1) & 2(0) + 0(1) + 1(2) + 3(-1) \\end{bmatrix}", "marks": 1 },
              { "do": "Simplify each entry.", "math": "AB = \\begin{bmatrix} 4 & -2 & 3 \\\\ 14 & 5 & -1 \\end{bmatrix}", "marks": 0.5 }
            ]
          }
        }
      ]
    },
    {
      "name": "Level 3",
      "marks": 14,
      "questions": [
        {
          "n": 6,
          "marks": 5,
          "type": "long",
          "question": "If $A = \\begin{bmatrix} 1 & -1 & 2 \\\\ 0 & 2 & -3 \\\\ 3 & -2 & 4 \\end{bmatrix}$, find $A^{-1}$. Hence solve $x - y + 2z = 1$, $2y - 3z = 1$, $3x - 2y + 4z = 2$.",
          "solution": {
            "answer": "$x = 0,\\ y = 5,\\ z = 3$",
            "concept": "$A^{-1} = \\dfrac{1}{|A|}\\,\\text{adj}\\,A$, and $AX = B$ gives $X = A^{-1}B$.",
            "steps": [
              { "do": "Expand $|A|$ along $R_1$.", "math": "|A| = \\begin{vmatrix} 1 & -1 & 2 \\\\ 0 & 2 & -3 \\\\ 3 & -2 & 4 \\end{vmatrix} = 1(8 - 6) + 1(0 + 9) + 2(0 - 6) = -1", "marks": 1 },
              { "do": "$|A| \\neq 0$, so $A^{-1}$ exists.", "why": "A square matrix is invertible exactly when $|A| \\neq 0$." },
              { "do": "Find the cofactors.", "math": "\\begin{aligned} &C_{11} = 2,\\quad C_{12} = -9,\\quad C_{13} = -6 \\\\ &C_{21} = 0,\\quad C_{22} = -2,\\quad C_{23} = -1 \\\\ &C_{31} = -1,\\quad C_{32} = 3,\\quad C_{33} = 2 \\end{aligned}", "marks": 1 },
              { "do": "Write $A^{-1} = \\dfrac{1}{|A|}\\,\\text{adj}\\,A$.", "math": "A^{-1} = \\dfrac{1}{-1}\\begin{bmatrix} 2 & 0 & -1 \\\\ -9 & -2 & 3 \\\\ -6 & -1 & 2 \\end{bmatrix} = \\begin{bmatrix} -2 & 0 & 1 \\\\ 9 & 2 & -3 \\\\ 6 & 1 & -2 \\end{bmatrix}", "why": "adj $A$ is the transpose of the cofactor matrix.", "marks": 1 },
              { "do": "Write the system as $AX = B$, so $X = A^{-1}B$.", "math": "\\begin{bmatrix} x \\\\ y \\\\ z \\end{bmatrix} = \\begin{bmatrix} -2 & 0 & 1 \\\\ 9 & 2 & -3 \\\\ 6 & 1 & -2 \\end{bmatrix} \\begin{bmatrix} 1 \\\\ 1 \\\\ 2 \\end{bmatrix} = \\begin{bmatrix} -2 + 0 + 2 \\\\ 9 + 2 - 6 \\\\ 6 + 1 - 4 \\end{bmatrix} = \\begin{bmatrix} 0 \\\\ 5 \\\\ 3 \\end{bmatrix}", "marks": 1.5 },
              { "do": "Hence the solution is", "math": "x = 0,\\quad y = 5,\\quad z = 3", "marks": 0.5 }
            ],
            "mistake": "Forgetting to transpose the cofactor matrix when writing adj $A$."
          }
        },
        {
          "n": 7,
          "marks": 5,
          "type": "long",
          "question": "Using integration, find the area of the region bounded by the parabola $y = x^2$ and the line $y = 4$.",
          "solution": {
            "answer": "Required area $= \\dfrac{32}{3}$ sq. units",
            "concept": "Area between two curves $= \\displaystyle\\int_a^b (\\text{upper} - \\text{lower})\\,dx$.",
            "figure": "figs/sol-area.svg",
            "steps": [
              { "do": "Find where the curves meet: put $y = 4$ in $y = x^2$.", "math": "x^2 = 4 \\Rightarrow x = \\pm 2", "marks": 1 },
              { "do": "Draw the region between the curves (see figure).", "marks": 1 },
              { "do": "The region is symmetric about the $y$-axis, so take twice the right half.", "math": "\\text{Area} = 2\\int_{0}^{2} (4 - x^2)\\,dx", "marks": 1 },
              { "do": "Integrate and put in the limits.", "math": "\\begin{aligned} &= 2\\left[4x - \\dfrac{x^3}{3}\\right]_{0}^{2} \\\\ &= 2\\left(8 - \\dfrac{8}{3}\\right) \\end{aligned}", "marks": 1 },
              { "do": "Simplify.", "math": "= 2 \\times \\dfrac{16}{3} = \\dfrac{32}{3}", "why": "Area is always taken positive.", "marks": 0.5 },
              { "do": "Required area $= \\dfrac{32}{3}$ sq. units.", "marks": 0.5 }
            ]
          }
        },
        {
          "n": 8,
          "marks": 4,
          "type": "case",
          "question": "A bag contains 4 red and 6 black balls. Two balls are drawn one after the other **without replacement**. Based on this, answer the following.",
          "parts": [
            { "label": "(i)", "text": "Find the probability that both balls are red.", "marks": 1 },
            { "label": "(ii)", "text": "Find the probability that the second ball is black, given that the first is red.", "marks": 1 },
            { "label": "(iii)(a)", "text": "Find the probability distribution of $X$, the number of red balls drawn.", "marks": 2 },
            { "label": "(iii)(b)", "text": "Find the mean number of red balls drawn.", "marks": 2, "alt": true }
          ],
          "solution": {
            "answer": "(i) $\\dfrac{2}{15}$ (ii) $\\dfrac{2}{3}$ (iii)(a) $P(0) = \\dfrac{1}{3},\\ P(1) = \\dfrac{8}{15},\\ P(2) = \\dfrac{2}{15}$ OR (iii)(b) $\\dfrac{4}{5}$",
            "parts": [
              {
                "label": "(i)",
                "steps": [
                  { "do": "Multiply the probabilities of red, then red.", "math": "P(RR) = \\dfrac{4}{10} \\times \\dfrac{3}{9} = \\dfrac{2}{15}", "marks": 1 }
                ],
                "answer": "$\\dfrac{2}{15}$"
              },
              {
                "label": "(ii)",
                "steps": [
                  { "do": "After one red ball, 9 balls are left and 6 are black.", "math": "P(B_2 \\mid R_1) = \\dfrac{6}{9} = \\dfrac{2}{3}", "marks": 1 }
                ],
                "answer": "$\\dfrac{2}{3}$"
              },
              {
                "label": "(iii)(a)",
                "steps": [
                  { "do": "$X$ can be $0$, $1$ or $2$.", "marks": 0.5 },
                  { "do": "Find each probability.", "math": "\\begin{aligned} P(X = 0) &= \\dfrac{6}{10} \\times \\dfrac{5}{9} = \\dfrac{1}{3} \\\\ P(X = 1) &= 2 \\times \\dfrac{4}{10} \\times \\dfrac{6}{9} = \\dfrac{8}{15} \\\\ P(X = 2) &= \\dfrac{4}{10} \\times \\dfrac{3}{9} = \\dfrac{2}{15} \\end{aligned}", "why": "One red can come first or second, hence the factor 2.", "marks": 1.5 }
                ],
                "answer": "$P(0) = \\dfrac{1}{3},\\ P(1) = \\dfrac{8}{15},\\ P(2) = \\dfrac{2}{15}$"
              },
              {
                "label": "(iii)(b)",
                "alt": true,
                "steps": [
                  { "do": "Use the distribution from (iii)(a).", "math": "E(X) = \\sum x_i\\,P(x_i) = 0 \\times \\dfrac{1}{3} + 1 \\times \\dfrac{8}{15} + 2 \\times \\dfrac{2}{15} = 0 + \\dfrac{8}{15} + \\dfrac{4}{15} = \\dfrac{12}{15} = \\dfrac{4}{5}", "marks": 2 }
                ],
                "answer": "Mean $= \\dfrac{4}{5}$"
              }
            ],
            "mistake": "Without replacement, the second draw is out of 9 balls, not 10."
          }
        }
      ]
    }
  ]
