            "steps": [
              { "do": "Let", "math": "I = \\displaystyle\\int_0^{\\pi} \\dfrac{x\\tan x}{\\sec x + \\tan x}\\,dx \\quad \\ldots(1)" },
              { "do": "Replace $x$ by $\\pi - x$; $\\tan$ and $\\sec$ both change sign", "math": "I = \\displaystyle\\int_0^{\\pi} \\dfrac{(\\pi - x)(-\\tan x)}{-\\sec x - \\tan x}\\,dx = \\int_0^{\\pi} \\dfrac{(\\pi - x)\\tan x}{\\sec x + \\tan x}\\,dx \\quad \\ldots(2)", "marks": 1 },
              { "do": "Add (1) and (2)", "math": "2I = \\pi\\displaystyle\\int_0^{\\pi} \\dfrac{\\tan x}{\\sec x + \\tan x}\\,dx", "marks": 0.5 },
              { "do": "Multiply top and bottom by $\\cos x$", "math": "\\dfrac{\\tan x}{\\sec x + \\tan x} = \\dfrac{\\sin x}{1 + \\sin x} = 1 - \\dfrac{1}{1 + \\sin x}", "marks": 0.5 },
