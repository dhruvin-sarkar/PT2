            "steps": [
              { "do": "Integrate by parts, taking $u = x$, $v = \\sin x$", "math": "\\displaystyle\\int x\\sin x\\,dx = -x\\cos x + \\int\\cos x\\,dx = -x\\cos x + \\sin x" },
              { "do": "Put the limits", "math": "\\big[-x\\cos x + \\sin x\\big]_0^{\\pi/2} = \\left(-\\dfrac{\\pi}{2}\\cdot 0 + 1\\right) - (0 + 0)" },
