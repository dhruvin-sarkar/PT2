          "source": "PYQ-style",
          "question": "$\\displaystyle\\int e^x \\sec x\\,(1 + \\tan x)\\,dx$ is equal to:",
          "options": [
            "$e^x\\cos x + C$",
            "$e^x\\sec x + C$",
            "$e^x\\sin x + C$",
            "$e^x\\tan x + C$"
          ],
          "solution": {
            "answer": "(B) $e^x\\sec x + C$",
            "concept": "$\\displaystyle\\int e^x\\,[f(x) + f'(x)]\\,dx = e^x f(x) + C$",
            "steps": [
              { "do": "Open the bracket", "math": "e^x\\sec x\\,(1 + \\tan x) = e^x\\,(\\sec x + \\sec x\\tan x)" },
              { "do": "Take $f(x) = \\sec x$", "math": "f'(x) = \\sec x\\tan x" },
              { "do": "So the integral is", "math": "\\displaystyle\\int e^x(\\sec x + \\sec x\\tan x)\\,dx = e^x\\sec x + C", "marks": 1 }
            ],
            "mistake": "Picking (D): $f(x) = \\tan x$ needs $f'(x) = \\sec^2 x$, which is not in the bracket."
          }
        },
        {
