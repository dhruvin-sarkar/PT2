            "steps": [
              { "do": "Put $1 + x^2 = t$", "math": "2x\\,dx = dt, \\qquad x^2 = t - 1" },
              { "do": "Write $x^3\\,dx = x^2\\cdot x\\,dx$ and substitute", "math": "\\displaystyle\\int \\dfrac{x^3}{\\sqrt{1 + x^2}}\\,dx = \\dfrac{1}{2}\\int \\dfrac{t - 1}{\\sqrt t}\\,dt = \\dfrac{1}{2}\\int \\left(t^{1/2} - t^{-1/2}\\right)dt" },
              { "do": "Integrate", "math": "\\dfrac{1}{2}\\left(\\dfrac{2}{3}t^{3/2} - 2t^{1/2}\\right) + C = \\dfrac{1}{3}t^{3/2} - t^{1/2} + C" },
              { "do": "Put back $t = 1 + x^2$ and compare", "math": "\\dfrac{1}{3}\\left(1 + x^2\\right)^{3/2} - \\sqrt{1 + x^2} + C \\;\\Rightarrow\\; a = \\dfrac{1}{3},\\; b = -1", "marks": 1 }
            ],
            "mistake": "Forgetting the $\\dfrac{1}{2}$ from $x\\,dx = \\dfrac{dt}{2}$, which doubles both $a$ and $b$."
          }
        },
        {
