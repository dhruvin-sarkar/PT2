              {
                "do": "$E$, $F$ independent, so $E$, $\\bar{F}$ are independent.",
                "math": "P(E \\cap \\bar{F}) = P(E)\\,P(\\bar{F})"
              },
              {
                "do": "Apply the conditional probability formula.",
                "math": "P(E|\\bar{F}) = \\dfrac{P(E)\\,P(\\bar{F})}{P(\\bar{F})} = P(E) = \\dfrac{2}{3}",
                "marks": 1
              },
              {
                "do": "Pick the matching option.",
                "math": "\\text{Option (C)}"
              }
            ],
            "mistake": "Answering $P(\\bar{F}) = \\dfrac{4}{7}$ or multiplying: for independent events the condition does not change $P(E)$."
          }
