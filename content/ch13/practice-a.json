          "source": "Board-pattern",
          "question": "If $P(A|B) = 0.3$, $P(A) = 0.4$ and $P(B) = 0.8$, then $P(B|A)$ is:",
          "options": [
            "$0.6$",
            "$0.3$",
            "$0.06$",
            "$0.4$"
          ],
          "solution": {
            "answer": "(A) $0.6$",
            "concept": "Multiplication rule: $P(A \\cap B) = P(B)\\,P(A|B) = P(A)\\,P(B|A)$.",
            "steps": [
              {
                "do": "Find $P(A \\cap B)$ by the multiplication rule.",
                "math": "P(A \\cap B) = P(B)\\cdot P(A|B) = 0.8 \\times 0.3 = 0.24"
              },
              {
                "do": "Now divide by $P(A)$.",
                "math": "P(B|A) = \\dfrac{P(A \\cap B)}{P(A)} = \\dfrac{0.24}{0.4} = 0.6",
                "marks": 1
              },
              {
                "do": "Pick the matching option.",
                "math": "\\text{Option (A)}"
              }
            ],
            "mistake": "Answering $0.3$: $P(B|A)$ and $P(A|B)$ are not the same."
          }
        },
        {
