          "source": "PYQ-style",
          "question": "If $\\begin{vmatrix} x+1 & x-1 \\\\ x-3 & x+2 \\end{vmatrix} = \\begin{vmatrix} 4 & -1 \\\\ 1 & 3 \\end{vmatrix}$, then $x$ is equal to:",
          "options": [
            "$\\dfrac{12}{7}$",
            "$2$",
            "$-2$",
            "$\\dfrac{8}{7}$"
          ],
          "solution": {
            "answer": "(B) $2$",
            "concept": "$\\begin{vmatrix} a & b \\\\ c & d \\end{vmatrix} = ad - bc$",
            "steps": [
              {
                "do": "Expand the LHS.",
                "math": "(x+1)(x+2) - (x-1)(x-3) = (x^2+3x+2) - (x^2-4x+3) = 7x - 1"
              },
              {
                "do": "Expand the RHS.",
                "math": "4(3) - (-1)(1) = 12 + 1 = 13"
              },
              {
                "do": "Equate and solve.",
                "math": "7x - 1 = 13 \\;\\Rightarrow\\; x = 2",
                "marks": 1
              },
              {
                "do": "Hence option (B)."
              }
            ],
            "mistake": "Writing the RHS as $12 - 1 = 11$; here $bc = (-1)(1) = -1$, so $ad - bc = 12 + 1$."
          }
        },
