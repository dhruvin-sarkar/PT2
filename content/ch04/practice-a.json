            "$x_1x_2$"
          ],
          "solution": {
            "answer": "(A) $x_2y_1$",
            "concept": "Three points are collinear when the area of the triangle they form is $0$.",
            "steps": [
              {
                "do": "Collinear, so the area determinant is zero.",
                "math": "\\begin{vmatrix} x_1 & y_1 & 1 \\\\ x_2 & y_2 & 1 \\\\ x_1+x_2 & y_1+y_2 & 1 \\end{vmatrix} = 0"
              },
              {
                "do": "Expand along $R_1$.",
                "math": "x_1(y_2 - y_1 - y_2) - y_1(x_2 - x_1 - x_2) + (x_2y_1 + x_2y_2 - x_1y_2 - x_2y_2) = 0"
              },
              {
                "do": "Simplify.",
                "math": "-x_1y_1 + x_1y_1 + x_2y_1 - x_1y_2 = 0 \\;\\Rightarrow\\; x_1y_2 = x_2y_1",
                "marks": 1
              },
              {
                "do": "Hence option (A)."
              }
            ]
          }
        },
