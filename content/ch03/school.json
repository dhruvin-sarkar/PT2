          "type": "mcq",
          "question": "If $A$ is a square matrix such that $A^2 = A$, then $(I + A)^3 - 7A$ is equal to:",
          "options": [
            "$A$",
            "$I - A$",
            "$I$",
            "$3A$"
          ],
          "solution": {
            "answer": "(C) $I$",
            "concept": "$A$ and $I$ commute ($AI = IA = A$), so $(I+A)^3$ expands like $(1+a)^3$.",
            "steps": [
              {
                "do": "From $A^2 = A$, get $A^3$.",
                "math": "A^3 = A^2 \\cdot A = A \\cdot A = A^2 = A"
              },
              {
                "do": "Expand $(I + A)^3$.",
                "math": "(I+A)^3 = I + 3A + 3A^2 + A^3",
                "why": "Allowed because $AI = IA$."
              },
              {
                "do": "Put $A^2 = A$, $A^3 = A$.",
                "math": "(I+A)^3 = I + 3A + 3A + A = I + 7A"
              },
              {
                "do": "Subtract $7A$.",
                "math": "(I+A)^3 - 7A = I + 7A - 7A = I",
                "marks": 1
              },
              {
                "do": "Hence option (C)."
              }
            ]
          }
        },
