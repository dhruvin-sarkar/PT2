          "solution": {
            "answer": "(A) Only $AB$",
            "concept": "$PQ$ is defined only when (columns of $P$) $=$ (rows of $Q$).",
            "steps": [
              {
                "do": "Write the orders.",
                "math": "A_{3\\times 3},\\quad B_{3\\times 1},\\quad C_{1\\times 3}"
              },
              {
                "do": "Check $AB$: columns of $A$ = 3 = rows of $B$.",
                "math": "AB \\text{ is defined, of order } 3\\times 1",
                "marks": 1
              },
              {
                "do": "Check $AC$: columns of $A$ = 3, rows of $C$ = 1.",
                "math": "3 \\ne 1 \\;\\Rightarrow\\; AC \\text{ is not defined}"
              },
              {
                "do": "Check $BA$: columns of $B$ = 1, rows of $A$ = 3.",
                "math": "1 \\ne 3 \\;\\Rightarrow\\; BA \\text{ is not defined}"
              },
              {
                "do": "Hence only $AB$ is defined. Option (A)."
              }
            ],
            "mistake": "Checking rows of the first matrix against columns of the second — it is the other way round."
          }
        },
