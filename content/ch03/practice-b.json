          "question": "If $A$ is a matrix of order $m \\times n$ and $B$ is a matrix such that $AB'$ and $B'A$ are both defined, then the order of $B$ is:",
          "options": [
            "$m \\times m$",
            "$n \\times n$",
            "$n \\times m$",
            "$m \\times n$"
          ],
          "solution": {
            "answer": "(D) $m \\times n$",
            "concept": "$P_{a \\times b}\\,Q_{c \\times d}$ is defined only if $b = c$.",
            "steps": [
              {
                "do": "Let $B$ be of order $u \\times v$, so $B'$ is $v \\times u$."
              },
              {
                "do": "$A_{m \\times n}B'_{v \\times u}$ is defined.",
                "math": "n = v"
              },
              {
                "do": "$B'_{v \\times u}A_{m \\times n}$ is defined.",
                "math": "u = m"
              },
              {
                "do": "So $B$ has order $u \\times v = m \\times n$. Option (D).",
                "marks": 1
              }
            ],
            "mistake": "Finding the order of $B'$ ($n \\times m$) and forgetting to transpose back to $B$."
          }
