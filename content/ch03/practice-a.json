          "source": "CBSE SQP 2025-26",
          "question": "If for three matrices $A = [a_{ij}]_{m \\times 4}$, $B = [b_{ij}]_{n \\times 3}$ and $C = [c_{ij}]_{p \\times q}$, the products $AB$ and $AC$ are both defined and are square matrices of the same order, then the values of $m, n, p$ and $q$ are:",
          "options": [
            "$m = q = 3$ and $n = p = 4$",
            "$m = 2,\\ q = 3$ and $n = p = 4$",
            "$m = q = 4$ and $n = p = 3$",
            "$m = 4,\\ p = 2$ and $n = q = 3$"
          ],
          "solution": {
            "answer": "(A) $m = q = 3$ and $n = p = 4$",
            "concept": "$P_{a \\times b}\\,Q_{c \\times d}$ is defined only if $b = c$; the product has order $a \\times d$.",
            "steps": [
              {
                "do": "$AB$ is defined, so columns of $A$ = rows of $B$.",
                "math": "n = 4,\\qquad AB \\text{ has order } m \\times 3"
              },
              {
                "do": "$AB$ is square.",
                "math": "m = 3"
              },
              {
                "do": "$AC$ is defined, so columns of $A$ = rows of $C$.",
                "math": "p = 4,\\qquad AC \\text{ has order } m \\times q = 3 \\times q"
              },
              {
                "do": "$AC$ is square of the same order as $AB$.",
                "math": "q = 3 \\;\\Rightarrow\\; m = q = 3,\\ n = p = 4",
                "marks": 1
              },
              {
                "do": "Hence option (A)."
              }
            ],
            "mistake": "Matching the rows of the first matrix with the columns of the second, which is the wrong way round."
          }
