{
  "name": "pt2",
  "version": "1.0.0",
  "description": "Class 12 CBSE Mathematics worksheets with step-wise solution PDFs and a catalogue website",
  "scripts": {
    "validate": "node tools/validate-all.mjs",
    "build:pdf": "node tools/build-pdf.mjs",
    "build:site": "node tools/build-site.mjs",
    "build": "node tools/validate-all.mjs --warn-only && node tools/build-pdf.mjs && node tools/build-site.mjs",
    "serve": "node tools/serve.mjs",
    "fixture:pdf": "node tools/build-pdf.mjs --content tools/fixture"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhruvin-sarkar/PT2.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/dhruvin-sarkar/PT2/issues"
  },
  "homepage": "https://github.com/dhruvin-sarkar/PT2#readme",
  "private": "true",
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "katex": "^0.19.1",
    "puppeteer-core": "^25.17.0"
  }
}
